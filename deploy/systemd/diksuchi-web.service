[Unit]
Description=Diksuchi AI - Web Frontend (Next.js on port 3000)
After=diksuchi-rag-api.service
Requires=diksuchi-infra.service

[Service]
Type=simple
WorkingDirectory=/home/avision/workspace/diksuchi-ai/services/web
ExecStart=/home/avision/.nvm/versions/node/v22.22.1/bin/pnpm start
Restart=on-failure
RestartSec=5
Environment=PATH=/home/avision/.nvm/versions/node/v22.22.1/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production

[Install]
WantedBy=default.target
