[Unit]
Description=Diksuchi AI - Ollama Model Preload (gemma4:e4b)
After=network-online.target
Wants=network-online.target
Documentation=https://github.com/ollama/ollama

[Service]
Type=oneshot
ExecStart=/bin/bash /home/avision/workspace/diksuchi-ai/scripts/preload-ollama-models.sh
