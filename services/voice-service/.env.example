# STT Configuration
STT_MODEL_NAME=large-v3
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
STT_VAD_FILTER=true

# TTS Configuration
TTS_MODEL_NAME=ai4bharat/indic-parler-tts
TTS_DEVICE=auto

# Common Configuration
VOICE_SERVICE_PORT=8000

# HuggingFace Token (only needed when running prefetch_models.py on a
# connected machine; not used at runtime in offline deployments).
HF_TOKEN=your_token_here

# --------------------------------------------------
# Offline / air-gapped deployment
# --------------------------------------------------
# Set HF_HUB_OFFLINE=1 to forbid every network call to the HuggingFace
# Hub at startup. The voice service will only load weights from the
# local cache. Run `python prefetch_models.py` once on a machine with
# internet access to populate the cache before enabling this flag.
HF_HUB_OFFLINE=1

# Disable usage telemetry pings emitted by transformers / huggingface_hub.
HF_HUB_DISABLE_TELEMETRY=1

# Optional: explicit cache directory. Defaults to ~/.cache/huggingface/hub.
# Useful when shipping a baked cache as a Docker volume or directory.
# HF_HUB_CACHE=/var/lib/voice-service/hf-cache
